# The test image: the application's dependencies, plus the ones only the
# tests need. Separate from Dockerfile so the thing that ships to Railway
# carries no test runner and no javascript runtime.
#
#   docker build -f Dockerfile.test -t petrosil-module:test .
#   docker run --rm -v "$PWD:/src" -w /src petrosil-module:test python -m pytest -q
#
# The repo is mounted rather than copied, so an edit needs no rebuild. Only a
# change to requirements.txt or to tests/browser/package.json does.
FROM python:3.12-slim

WORKDIR /app

# node is here for one test: tests/test_rules_screen_in_a_browser.py drives
# the price-rules screen under jsdom, because most of what that screen does
# is script and searching the rendered HTML proves none of it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs npm \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt pytest httpx

# Outside the working directory on purpose: the repo is bind-mounted over
# /src at run time, which would hide a node_modules installed inside it.
COPY tests/browser/package.json /opt/browser-tests/
RUN npm install --prefix /opt/browser-tests --no-audit --no-fund
ENV NODE_PATH=/opt/browser-tests/node_modules

ENV PYTHONUNBUFFERED=1
