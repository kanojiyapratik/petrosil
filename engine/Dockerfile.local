# Local development only: the engine's code on top of an image that already
# has every dependency in requirements.txt installed (the standalone module's
# local image, same versions), so a code change does not wait on PyPI.
# Production builds from ./Dockerfile, which installs them itself.
FROM petrosil-module:py

WORKDIR /app

COPY app ./app
COPY scraper ./scraper

ENV PYTHONUNBUFFERED=1

# The same process switch as ./Dockerfile (the base image predates the third one).
CMD if [ "$MODULE_PROCESS" = "crawler" ]; then exec python -m scraper.main; elif [ "$MODULE_PROCESS" = "estate-crawler" ]; then exec python -m scraper.estate; else exec uvicorn app.main:create_app --factory --host 0.0.0.0 --port ${PORT:-8094}; fi
