DATABASE_URL=postgres://petrosil:petrosil@127.0.0.1:5434/petrosil
AUTH_SECRET=change-me

# Razorpay. Without these, orders are still created but cannot be settled
# (the signature check has nothing to verify against). The live pair lives in
# the old sites' settings table; these are local placeholders.
RAZORPAY_KEY_ID=rzp_test_local
RAZORPAY_KEY_SECRET=local_dev_secret_not_real

# Outgoing mail (Brevo). Until both are set the queue fills and nothing is
# sent -- nothing is lost either. MAIL_FROM must be a sender verified in Brevo.
# The sender's display name is each brand's name.
BREVO_API_KEY=
MAIL_FROM=
# Where links in mail point. {domain} is the brand's own domain.
# MAIL_LINK_BASE=https://{domain}

# Background jobs (mail delivery every minute, expiry sweep daily 11:00 IST).
# On by default in production; on a laptop only with JOBS=on, so a copy of the
# real estate never mails anyone by accident. `npm run jobs -- --status`.
# JOBS=on

# Files (report PDFs, trade sheets, images). Without FILES_S3_BUCKET they go to
# a directory: FILES_DIR, default storage/files. The estate's files come to
# about 14 GB, so production wants a bucket: R2, S3, or any S3-compatible store.
# FILES_DIR=storage/files
# FILES_S3_BUCKET=
# FILES_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# FILES_S3_KEY=
# FILES_S3_SECRET=
# FILES_S3_REGION=auto
# FILES_S3_PATH_STYLE=false

# The price module. Its per-market rules and rounding live in its own
# database and are shown read-only on each brand's Rules screen; the
# connection is opened read-only. MODULE_CONSOLE_URL is where "Edit on the
# price console" points.
# MODULE_DATABASE_URL=postgres://module:module@127.0.0.1:5433/module
# MODULE_CONSOLE_URL=http://localhost:8096

# The AI engine (engine/, docker compose service "engine"): the brand's AI
# tools tab calls it. ENGINE_TOKEN is the engine's own PRICE_API_TOKEN; never
# give the engine a public address, only this app talks to it.
# ENGINE_URL=http://127.0.0.1:8097
# ENGINE_TOKEN=
