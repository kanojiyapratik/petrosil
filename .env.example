# Shared bearer token every calling site sends as `Authorization: Bearer <token>`.
# The service refuses to start without it, and the auth middleware fails closed.
PRICE_API_TOKEN=

# The only configured provider. Note the key travels in Gemini's URL query
# string, which is why every error message from the driver is redacted.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional.
AI_DEFAULT_MODEL=gemini-2.5-flash
PORT=8094

# ---- Crawler (the Python service in ./scraper) -----------------------------
# The site the crawler works for. It holds no database credentials: it asks
# this API what to watch and posts back what it read.
SITE_API_URL=https://baseoilreport.com/api
SITE_API_TOKEN=

# How often to check. 900 = 15 minutes.
CRAWL_INTERVAL_SECONDS=900
CRAWL_TIMEOUT_SECONDS=30

# The site itself gets a longer budget: baseoil is a cold Laravel 7 and
# regularly takes 15-20s to answer.
SITE_API_TIMEOUT_SECONDS=120
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; PetrosilPriceBot/0.1; +https://petrosil.com)

# Backstop on a runaway paste into the site's URL textarea.
CRAWL_MAX_URLS=50
CRAWL_MAX_REGION_CHARS=8000

# ---- Admin console (the UI in ./src/console) -------------------------------
# Setting CONSOLE_SECRET switches the console on at /console. Unset, this
# deployment serves the API only and publishes no login page. Must be 32+
# characters; changing it signs everyone out.
CONSOLE_SECRET=

# The sites the console can drive. Each is reached with its own API token,
# exactly as the crawler does it.
# [{"id":"baseoil","name":"Base Oil Report","apiUrl":"https://baseoilreport.com/api","token":"..."}]
CONSOLE_SITES=

# Who can sign in. Generate a hash with: npm run console:hash -- 'the password'
# [{"email":"you@example.com","name":"You","passwordHash":"scrypt:..."}]
CONSOLE_USERS=

# Session cookies are Secure by default. Set to 1 only for a plain-http local
# run, where a Secure cookie is never sent back and login silently fails.
CONSOLE_INSECURE_COOKIES=
