{
  "name": "petrosil-platform",
  "version": "0.1.0",
  "private": true,
  "description": "The Petrosil umbrella platform: one application serving every brand, with the compat API the Python price module already speaks.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3100",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:up": "docker compose up -d && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:dev-data": "tsx --env-file-if-exists=.env scripts/dev-data.ts",
    "migrate:site": "tsx --env-file-if-exists=.env scripts/migrate-site.ts",
    "sweep:expiries": "tsx --env-file-if-exists=.env scripts/sweep-expiries.ts",
    "migrate:content": "tsx --env-file-if-exists=.env scripts/migrate-content.ts",
    "jobs": "tsx --env-file-if-exists=.env scripts/jobs.ts",
    "import:files": "tsx --env-file-if-exists=.env scripts/import-files.ts",
    "engine:link": "tsx --env-file-if-exists=.env scripts/engine-link.ts",
    "backfill:profiles": "tsx --env-file-if-exists=.env scripts/backfill-profiles.ts",
    "trade:feeds": "tsx --env-file-if-exists=.env scripts/seed-trade-feeds.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@netlify/database": "^2.0.1",
    "bcryptjs": "2.4.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "mysql2": "^3.11.5",
    "next": "^16.4.6",
    "postgres": "3.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "2.18.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.5",
    "@types/react": "19.0.7",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "netlify-cli": "^27.20.0",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
